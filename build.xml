<project name="publish-jstacs" basedir=".">
	
	<!--
		You should set the build dir, i.e. the directory where the resulting zips and tars are created
		using the ant command line argument -Dbuilddir="/my/funny/dir/"
		<property name="builddir" value="/Users/dev/Documents/jstacs_downloads/" />
	-->
	
	<property name="version" value="2.5" />
	<property name="builddir" value="${basedir}/build" />
	<property name="core.src.dir" value="modules/core/src/main/java" />
	<property name="core.resources.dir" value="modules/core/src/main/resources" />
	<property name="projects.src.dir" value="modules/projects/src/main/java" />
	<property name="projects.resources.dir" value="modules/projects/src/main/resources" />
	<property name="compile.classpath" value="${ant.compile.classpath}" />
	<path id="compile.path">
		<pathelement path="${compile.classpath}" />
	</path>
	<restrict id="dependency.jars">
		<path refid="compile.path" />
		<type type="file" />
		<name name="*.jar" />
	</restrict>
	<macrodef name="project-jar">
		<attribute name="name" />
		<sequential>
			<mkdir dir="${builddir}/projects/@{name}" />
			<jar destfile="${builddir}/projects/@{name}/@{name}-${version}.jar">
				<fileset dir="tempbin">
					<include name="de/**" />
					<include name="projects/@{name}/**" />
				</fileset>
			</jar>
		</sequential>
	</macrodef>

	<target name="check-classpath">
		<fail message="Classpath not provided. Run via Maven (mvn -pl modules/projects/ant package) or pass -Dant.compile.classpath to Ant." unless="ant.compile.classpath" />
	</target>
	
	<target name="prepare-libs" depends="check-classpath">
		<mkdir dir="${builddir}/lib" />
		<copy todir="${builddir}/lib" flatten="true" force="true">
			<resources refid="dependency.jars" />
		</copy>
	</target>
	
	<target name="javadoc" depends="prepare-libs">
		<javadoc access="protected" author="true" classpath="${compile.classpath}"
				destdir="${builddir}/jstacs-api" nodeprecated="false" nodeprecatedlist="false" noindex="false" nonavbar="false" notree="false"
				additionalparam="-encoding UTF-8"
				packagenames="de.jstacs.*"
				doctitle="Jstacs ${version} API Specification"
				source="1.8" sourcepath="${core.src.dir}:${projects.src.dir}" splitindex="true" use="true" version="true" verbose="false">
			<link href="http://www.biojava.org/docs/api1.9.1/" />
			<link href="http://docs.oracle.com/javase/7/docs/api/"/>
			<link href="http://rforge.net/org/doc/"/>
			<link href="http://www-sfb288.math.tu-berlin.de/~jtem/numericalMethods/api/"/>
			<link href="http://math.nist.gov/javanumerics/jama/doc/"/>
			<link href="https://xmlgraphics.apache.org/batik/javadoc/"/>
			<link href="https://samtools.github.io/htsjdk/javadoc/htsjdk/"/>
		</javadoc>
		<zip destfile="${builddir}/jstacs-api-${version}.zip">
			<zipfileset dir="${builddir}" includes="jstacs-api/**" />
			<zipfileset dir="." includes="COPYING.txt,ReadMe.txt" />
		</zip>
		<tar destfile="${builddir}/jstacs-api-${version}.tar.gz" compression="gzip" longfile="gnu">
			<tarfileset dir="${builddir}" includes="jstacs-api/**" />
			<tarfileset dir="." includes="COPYING.txt,ReadMe.txt" />
		</tar>
		<delete includeemptydirs="true">
			<fileset dir="${builddir}/jstacs-api" />
		</delete>
	</target>
	
	<target name="buildjar" depends="check-classpath">
		<mkdir dir="tempbin" />
		<delete includeemptydirs="true">
			<fileset dir="tempbin" includes="**/*" />
		</delete>
		<javac srcdir="${core.src.dir}:${projects.src.dir}" 
		       destdir="tempbin"
		       classpath="${compile.classpath}"
		       debug="on"
		       includeantruntime="false">
		</javac>
		<copy todir="tempbin">
			<fileset dir="${core.resources.dir}" erroronmissingdir="false" />
		</copy>
		<copy todir="tempbin">
			<fileset dir="${projects.resources.dir}" erroronmissingdir="false" />
		</copy>
		<jar destfile="${builddir}/jstacs-${version}.jar">
			<fileset dir="tempbin" />
		</jar>
		<project-jar name="cov2interval" />
		<project-jar name="dimont" />
		<project-jar name="dispom" />
		<project-jar name="dream2016" />
		<project-jar name="encodedream" />
		<project-jar name="gemoma" />
		<project-jar name="gemoseq" />
		<project-jar name="methyl" />
		<project-jar name="motifComp" />
		<project-jar name="quickscan" />
		<project-jar name="sigma" />
		<project-jar name="slim" />
		<project-jar name="talecorrect" />
		<project-jar name="talen" />
		<project-jar name="tals" />
		<project-jar name="xanthogenomes" />
		<delete includeemptydirs="true">
			<fileset dir="tempbin" />
		</delete>
	</target>

	
	<target name="bin" depends="buildjar,prepare-libs">
		<zip destfile="${builddir}/jstacs-bin-${version}.zip">
			<zipfileset dir="${builddir}" includes="jstacs-${version}.jar" prefix="jstacs-bin-${version}" />
			<zipfileset dir="${builddir}/lib" prefix="jstacs-bin-${version}/lib" />
			<zipfileset dir="." includes="COPYING.txt,ReadMe.txt" prefix="jstacs-bin-${version}" />
			<zipfileset dir="${core.resources.dir}/de/jstacs/utils" includes="de_jstacs_utils_UserTime.h,de_jstacs_utils_UserTime.c,libUserTime.jnilib,libUserTime.so,UserTime.dll" prefix="jstacs-bin-${version}/native" />
		</zip>
		<tar destfile="${builddir}/jstacs-bin-${version}.tar.gz" compression="gzip" longfile="gnu">
			<tarfileset dir="${builddir}" includes="jstacs-${version}.jar" prefix="jstacs-bin-${version}" />
			<tarfileset dir="${builddir}/lib" prefix="jstacs-bin-${version}/lib" />
			<tarfileset dir="." includes="COPYING.txt,ReadMe.txt" prefix="jstacs-bin-${version}" />
			<tarfileset dir="${core.resources.dir}/de/jstacs/utils" includes="de_jstacs_utils_UserTime.h,de_jstacs_utils_UserTime.c,libUserTime.jnilib,libUserTime.so,UserTime.dll" prefix="jstacs-bin-${version}/native" />
		</tar>
	</target>
	
	<target name="src">
		<zip destfile="${builddir}/jstacs-source-${version}.zip">
			<zipfileset dir="${core.src.dir}" includes="de/**" prefix="jstacs-source-${version}/de" />
			<zipfileset dir="${projects.src.dir}" includes="projects/**" prefix="jstacs-source-${version}/projects" />
			<zipfileset dir="${projects.resources.dir}" includes="projects/**" prefix="jstacs-source-${version}/projects" />
			<zipfileset dir="." includes="COPYING.txt,ReadMe.txt" prefix="jstacs-source-${version}" />
			<zipfileset dir="supplementary" includes="**/*" prefix="jstacs-source-${version}/supplementary" />
		</zip>
		<tar destfile="${builddir}/jstacs-source-${version}.tar.gz" compression="gzip" longfile="gnu">
			<tarfileset dir="${core.src.dir}" includes="de/**" prefix="jstacs-source-${version}/de" />
			<tarfileset dir="${projects.src.dir}" includes="projects/**" prefix="jstacs-source-${version}/projects" />
			<tarfileset dir="${projects.resources.dir}" includes="projects/**" prefix="jstacs-source-${version}/projects" />
			<tarfileset dir="." includes="COPYING.txt,ReadMe.txt" prefix="jstacs-source-${version}" />
			<tarfileset dir="supplementary" includes="**/*" prefix="jstacs-source-${version}/supplementary" />
		</tar>		
	</target>
	
	<target name="Dispom" depends="prepare-libs">
				<mkdir dir="tempbin" />
				<delete includeemptydirs="true">
					<fileset dir="tempbin" includes="**/*" />
				</delete>
				<javac srcdir="${core.src.dir}:${projects.src.dir}" 
			       destdir="tempbin"
			       classpath="${compile.classpath}"
			       debug="on"
			       includeantruntime="false">
			</javac>
			<mkdir dir="${builddir}/Dispom" />
		        <jar destfile="${builddir}/Dispom/Dispom.jar" filesetmanifest="mergewithoutmain">
		            <manifest>
		                <attribute name="Main-Class" value="projects.dispom.Dispom"/>
		                <attribute name="Class-Path" value="."/>
		            </manifest>
		            <fileset dir="tempbin"/>
		            <zipgroupfileset dir="${builddir}/lib" includes="biojava-live-*.jar" excludes="META-INF/*.SF"/>
		            <zipgroupfileset dir="${builddir}/lib" includes="biojava-bytecode-legacy-*.jar" excludes="META-INF/*.SF"/>
		            <zipgroupfileset dir="${builddir}/lib" includes="numerical-methods-*.jar" excludes="META-INF/*.SF"/>
		            <zipgroupfileset dir="${builddir}/lib" includes="Rserve-*.jar" excludes="META-INF/*.SF"/>
		            <zipgroupfileset dir="${builddir}/lib" includes="REngine-*.jar" excludes="META-INF/*.SF"/>
		        </jar>
				<jar destfile="${builddir}/Dispom/DispomPredictor.jar" filesetmanifest="mergewithoutmain">
				            <manifest>
				                <attribute name="Main-Class" value="projects.dispom.DispomPredictor"/>
				                <attribute name="Class-Path" value="."/>
				            </manifest>
				            <fileset dir="tempbin"/>
				            <zipgroupfileset dir="${builddir}/lib" includes="biojava-live-*.jar" excludes="META-INF/*.SF"/>
				            <zipgroupfileset dir="${builddir}/lib" includes="biojava-bytecode-legacy-*.jar" excludes="META-INF/*.SF"/>
				            <zipgroupfileset dir="${builddir}/lib" includes="numerical-methods-*.jar" excludes="META-INF/*.SF"/>
				            <zipgroupfileset dir="${builddir}/lib" includes="Rserve-*.jar" excludes="META-INF/*.SF"/>
				            <zipgroupfileset dir="${builddir}/lib" includes="REngine-*.jar" excludes="META-INF/*.SF"/>
				        </jar>
			<delete includeemptydirs="true">
				<fileset dir="tempbin" />
			</delete>
			<zip destfile="${builddir}/Dispom1.2.zip">
					<zipfileset dir="${projects.resources.dir}/projects/dispom" includes="Dispom-ReadMe.html" />
					<zipfileset dir="." includes="COPYING.txt" />
					<zipfileset dir="${builddir}/Dispom" includes="Dispom.jar,DispomPredictor.jar" />
			</zip>
			<delete includeemptydirs="true">
					<fileset dir="${builddir}/Dispom" />
			</delete>
	    </target>
	
	<target name="cleanjar" depends="buildjar">
		<delete file="${builddir}/jstacs-${version}.jar" />
	</target>

	<!-- Helper target for Maven packaging without regenerating Javadoc -->
	<target name="maven-package" depends="src,bin,cleanjar,Dispom,recipes" />
	
	<target name="recipes">
		<exec executable="sh">
			<arg value="supplementary/cookbook/comment_pkg_recipes.sh" />
		</exec>
		<zip destfile="${builddir}/recipes.zip">
			<zipfileset dir="supplementary/cookbook/recipes" includes="*" prefix="recipes" />
		</zip>
		<tar destfile="${builddir}/recipes.tar.gz" compression="gzip" longfile="gnu">
			<tarfileset dir="supplementary/cookbook/recipes" includes="*" prefix="recipes" />
		</tar>
		<exec executable="sh">
			<arg value="supplementary/cookbook/uncomment_pkg_recipes.sh" />
		</exec>
	</target>
	
	<target name="all" depends="src,bin,javadoc,cleanjar,Dispom,recipes" />
	
</project>
