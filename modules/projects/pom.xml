<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.jstacs</groupId>
    <artifactId>jstacs</artifactId>
    <version>2.5.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>jstacs-projects</artifactId>
  <name>Jstacs Projects</name>
  <description>CLI and helper projects built on top of Jstacs.</description>

  <dependencies>
    <dependency>
      <groupId>de.jstacs</groupId>
      <artifactId>jstacs-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <exportAntProperties>true</exportAntProperties>
        </configuration>
        <executions>
          <execution>
            <id>package-with-ant</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <property name="ant.compile.classpath" refid="maven.runtime.classpath"/>
                <ant antfile="${project.basedir}/../../build.xml" target="maven-package" inheritAll="false">
                  <property name="version" value="${project.version}"/>
                  <property name="builddir" value="${project.build.directory}/ant-build"/>
                  <property name="ant.compile.classpath" value="${ant.compile.classpath}"/>
                </ant>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
        <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <excludes>
              <!-- Exclude gemoma tests for now as they depend on missing data-->
              <exclude>projects/gemoma/JunitTest/**</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
